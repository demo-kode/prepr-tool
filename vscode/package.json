{
  "name": "prepr",
  "displayName": "PrePR",
  "description": "Review agent changes before the pull request, in a slicker VS Code tab.",
  "version": "0.4.0",
  "publisher": "demo-kode",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#111318",
    "theme": "dark"
  },
  "keywords": [
    "code review",
    "pull request",
    "agent",
    "diff"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/demo-kode/prepr-tool"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri",
    "onWebviewPanel:prepr"
  ],
  "contributes": {
    "commands": [
      {
        "command": "prepr.open",
        "title": "Show all reviews",
        "category": "PrePR"
      },
      {
        "command": "prepr.openReview",
        "title": "Open review\u2026",
        "category": "PrePR"
      }
    ],
    "configuration": {
      "title": "PrePR",
      "properties": {
        "prepr.url": {
          "type": "string",
          "default": "http://127.0.0.1:18744",
          "description": "PrePR service URL."
        },
        "prepr.toolPath": {
          "type": "string",
          "default": "",
          "description": "PrePR folder holding review.py. Set at install by `review.py vscode-install`. Used to keep the background agent runner up."
        },
        "prepr.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Python used to start the background agent runner."
        }
      }
    }
  }
}
